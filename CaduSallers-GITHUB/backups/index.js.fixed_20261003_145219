    payments: [], // New: Store Efí payment records
    settings: {
        currency: 'BRL',
        storeName: 'CaduSallers',
        cartCategoryName: '🛒・carrinhos',
        // Efí configuration
        efi: {
            clientId: '',
            clientSecret: '',
