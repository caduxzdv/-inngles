// Webhook endpoint for Efí Pix notifications
app.post('/webhook/efi', async (req, res) => {
    try {
        console.log('🔔 Received Efí webhook:', req.body);

        // Efí webhook validation (basic)
        if (!req.body || !req.body.pix) {
            console.warn('⚠️ Invalid webhook payload');
            return res.status(400).send('Invalid payload');
        }

        const pixData = req.body.pix;
        const txid = pixData.txid;

        if (!txid) {
            console.warn('⚠️ No txid in webhook payload');
            return res.status(400).send('Missing txid');
        }

        // Find order by txid
        const order = db.orders.find(o => o.txid === txid);
        if (!order) {
            console.warn(`⚠️ No order found for txid: ${txid}`);
            return res.status(404).send('Order not found');
        }

        // Prevent duplicate processing
        // In a production system, you'd want to store processed webhook IDs
        // For simplicity, we'll check if the status already matches

        let statusChanged = false;

        // Update order based on webhook data
        if (pixData.status === 'CONCLUIDA' && order.payment !== 'Confirmado') {
            order.payment = 'Confirmado';
            order.status = 'Pago';
            statusChanged = true;
            console.log(`✅ Payment confirmed for order ${order.id}`);
        } else if ((pixData.status === 'REMOVIDA_PELO_USUARIO_AGENTE' ||
                   pixData.status === 'REMOVIDA_PELO_USUARIO') &&
                   order.payment !== 'Cancelado') {
            order.payment = 'Cancelado';
            order.status = 'Cancelado';
            statusChanged = true;
            console.log(`❌ Payment cancelled for order ${order.id}`);
        } else if (pixData.status === 'EXPIRADA' && order.payment !== 'Expirado') {
            order.payment = 'Expirado';
            order.status = 'Expirado';
            statusChanged = true;
            console.log(`⏰ Payment expired for order ${order.id}`);
        }

        if (statusChanged) {
            saveDatabase();

            // TODO: Send notification to order channel if needed
            // This would require storing the channel ID and sending a message
            // For now, we rely on the user checking or using the verify button
        }

        // Return success to Efí
        return res.status(200).send('OK');
    } catch (error) {
        console.error('❌ Error processing Efí webhook:', error);
        return res.status(500).send('Internal server error');
    }
});

